library (lib_db_power) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  pulling_resistance_unit : "1kohm";
  capacitive_load_unit (1, pf);
  leakage_power_unit : "1nW";
  nom_process : 1.0;
  nom_temperature : 25.0;
  nom_voltage : 1.0;

  /* No pg_pins, so rail voltages come from the operating conditions. */
  operating_conditions (typ) {
    process : 1.0;
    temperature : 25.0;
    voltage : 1.0;
  }
  operating_conditions (hot) {
    process : 1.0;
    temperature : 125.0;
    voltage : 1.2;
  }
  default_operating_conditions : typ;

  scaling_factors (buf_scaling) {
    k_volt_internal_power_rise : 0.5;
    k_volt_internal_power_fall : 0.5;
    k_temp_internal_power_rise : 0.01;
    k_temp_internal_power_fall : 0.01;
  }

  /* Fanout 1 sits below the first entry, so the slope extrapolates it. */
  wire_load (wl) {
    capacitance : 0.2;
    resistance : 0.01;
    slope : 0.5;
    fanout_length (2, 2.0);
    fanout_length (3, 3.0);
  }

  lu_table_template (delay_load) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.001, 1.0");
  }
  power_lut_template (energy_load) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.001, 1.0");
  }

  cell (BUF) {
    area : 1.0;
    scaling_factors : buf_scaling;
    cell_leakage_power : 1.0;
    pin (A) { direction : input; capacitance : 0.01; }
    pin (Y) {
      direction : output;
      function : "A";
      timing () {
        related_pin : "A";
        cell_rise (delay_load) { values ("0.01, 0.5"); }
        cell_fall (delay_load) { values ("0.01, 0.5"); }
        rise_transition (delay_load) { values ("0.01, 0.5"); }
        fall_transition (delay_load) { values ("0.01, 0.5"); }
        /* Y's fastest slew, this retain slew under hot, caps its activity. */
        retaining_rise (delay_load) { values ("0.005, 0.2"); }
        retaining_fall (delay_load) { values ("0.005, 0.2"); }
        retain_rise_slew (delay_load) { values ("20.0, 20.0"); }
        retain_fall_slew (delay_load) { values ("20.0, 20.0"); }
      }
      internal_power () {
        related_pin : "A";
        rise_power (energy_load) { values ("0.001, 0.1"); }
        fall_power (energy_load) { values ("0.001, 0.1"); }
      }
    }
  }

  /* Replaces BUF's pin caps and timing under the hot operating conditions. */
  scaled_cell (BUF, hot) {
    area : 1.0;
    pin (A) { direction : input; capacitance : 0.05; }
    pin (Y) {
      direction : output;
      function : "A";
      timing () {
        related_pin : "A";
        cell_rise (delay_load) { values ("0.02, 0.8"); }
        cell_fall (delay_load) { values ("0.02, 0.8"); }
        rise_transition (delay_load) { values ("50.0, 50.0"); }
        fall_transition (delay_load) { values ("50.0, 50.0"); }
      }
    }
  }

  /* The flop is modeled only in test_cell, as some scan cells are. */
  cell (SDFF) {
    area : 4.0;
    cell_leakage_power : 2.0;
    pin (D) { direction : input; capacitance : 0.01; }
    pin (SI) { direction : input; capacitance : 0.01; }
    pin (SE) { direction : input; capacitance : 0.01; }
    pin (CK) { direction : input; capacitance : 0.01; clock : true; }
    pin (Q) {
      direction : output;
      timing () {
        related_pin : "CK";
        timing_type : rising_edge;
        cell_rise (delay_load) { values ("0.05, 0.6"); }
        cell_fall (delay_load) { values ("0.05, 0.6"); }
        rise_transition (delay_load) { values ("0.01, 0.5"); }
        fall_transition (delay_load) { values ("0.01, 0.5"); }
      }
      internal_power () {
        related_pin : "CK";
        rise_power (energy_load) { values ("0.002, 0.2"); }
        fall_power (energy_load) { values ("0.002, 0.2"); }
      }
    }
    test_cell () {
      ff (IQ, IQN) {
        next_state : "(D & !SE) | (SI & SE)";
        clocked_on : "CK";
      }
      pin (D) { direction : input; }
      pin (SI) { direction : input; signal_type : test_scan_in; }
      pin (SE) { direction : input; signal_type : test_scan_enable; }
      pin (CK) { direction : input; clock : true; }
      pin (Q) { direction : output; function : "IQ"; signal_type : test_scan_out; }
    }
  }
}
