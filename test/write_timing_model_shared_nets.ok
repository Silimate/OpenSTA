library (shared_nets_blk) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 25.0;
  nom_voltage                    : 1.80;


  cell ("shared_nets_blk") {
    area : 5.000 
    is_macro_cell : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.0010;
    }
    pin("a") {
      direction : input;
      capacitance : 0.0010;
    }
    pin("d") {
      direction : input;
      capacitance : 0.0010;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
        rise_constraint(scalar) {
          values("0.05000");
        }
        fall_constraint(scalar) {
          values("0.05000");
        }
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
        rise_constraint(scalar) {
          values("0.10000");
        }
        fall_constraint(scalar) {
          values("0.10000");
        }
      }
    }
    pin("y0") {
      direction : output;
      capacitance : 0.0300;
      timing() {
        related_pin : "a";
        timing_sense : positive_unate;
        timing_type : combinational;
        cell_rise(scalar) {
          values("0.50000");
        }
        rise_transition(scalar) {
          values("0.10000");
        }
        cell_fall(scalar) {
          values("0.50000");
        }
        fall_transition(scalar) {
          values("0.10000");
        }
      }
    }
    pin("y1") {
      direction : output;
      capacitance : 0.0300;
      timing() {
        related_pin : "a";
        timing_sense : positive_unate;
        timing_type : combinational;
        cell_rise(scalar) {
          values("0.50000");
        }
        rise_transition(scalar) {
          values("0.10000");
        }
        cell_fall(scalar) {
          values("0.50000");
        }
        fall_transition(scalar) {
          values("0.10000");
        }
      }
    }
    pin("t0") {
      direction : output;
      capacitance : 0.0700;
    }
    pin("t1") {
      direction : output;
      capacitance : 0.0700;
    }
    pin("t2") {
      direction : output;
      capacitance : 0.0000;
    }
    pin("q") {
      direction : output;
      capacitance : 0.0000;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
        cell_rise(scalar) {
          values("0.30000");
        }
        rise_transition(scalar) {
          values("0.10000");
        }
        cell_fall(scalar) {
          values("0.30000");
        }
        fall_transition(scalar) {
          values("0.10000");
        }
      }
    }
  }

}
