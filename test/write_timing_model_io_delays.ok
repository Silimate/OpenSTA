write_timing_model -scalar
  cell ("io_delays_blk") {
    area : 5.000 
    is_macro_cell : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.0010;
    }
    pin("a") {
      direction : input;
      capacitance : 0.0010;
    }
    pin("b") {
      direction : input;
      capacitance : 0.0010;
    }
    pin("d") {
      direction : input;
      capacitance : 0.0010;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
        rise_constraint(scalar) {
          values("0.05000");
        }
        fall_constraint(scalar) {
          values("0.05000");
        }
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
        rise_constraint(scalar) {
          values("0.10000");
        }
        fall_constraint(scalar) {
          values("0.10000");
        }
      }
    }
    pin("y") {
      direction : output;
      capacitance : 0.0000;
      timing() {
        related_pin : "a";
        timing_sense : positive_unate;
        timing_type : combinational;
        cell_rise(scalar) {
          values("0.40000");
        }
        rise_transition(scalar) {
          values("0.10000");
        }
        cell_fall(scalar) {
          values("0.40000");
        }
        fall_transition(scalar) {
          values("0.10000");
        }
      }
      timing() {
        related_pin : "b";
        timing_sense : positive_unate;
        timing_type : combinational;
        cell_rise(scalar) {
          values("0.40000");
        }
        rise_transition(scalar) {
          values("0.10000");
        }
        cell_fall(scalar) {
          values("0.40000");
        }
        fall_transition(scalar) {
          values("0.10000");
        }
      }
    }
    pin("q") {
      direction : output;
      capacitance : 0.0000;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
        cell_rise(scalar) {
          values("0.30000");
        }
        rise_transition(scalar) {
          values("0.10000");
        }
        cell_fall(scalar) {
          values("0.30000");
        }
        fall_transition(scalar) {
          values("0.10000");
        }
      }
    }
  }

}
