all_registers -clock clk1
u_blk1/blk_r1
all_registers -clock [get_clocks clk*]
u_blk1/blk_r1
u_blk1/blk_r2
all_registers -rise_clock clk2 -data_pins
u_blk1/blk_r2/D
all_registers -fall_clock clk1
all_inputs -clock clk1
in1
all_outputs -clock clk2
out
###############################################################################
# Created by write_sdc
