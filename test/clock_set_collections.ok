current_design dut
###############################################################################
# Timing Constraints
###############################################################################
create_clock -name clk1 -period 10.0000 [get_ports {clk1}]
create_clock -name clk2 -period 10.0000 [get_ports {clk2}]
set_sense -type clock -positive -clock [get_clocks {clk1}] [get_pins {u_blk1/blk_r1/CK}]
set_clock_groups -name group1 -asynchronous \
 -group [get_clocks {clk1}]\
 -group [get_clocks {clk2}]
set_input_delay 1.0000 -clock [get_clocks {clk1}] -add_delay [get_ports {in1}]
set_output_delay 1.0000 -clock [get_clocks {clk2}] -add_delay [get_ports {out}]
